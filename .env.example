# Copy to `.env` (same folder) and fill in your keys. `.env` is loaded
# automatically at startup; a real environment variable always overrides it.
# Never commit `.env` or paste these keys into chat.

# Required: Gemini free tier — base + flash/pro + search grounding.
# Get one at https://aistudio.google.com/apikey (no billing needed).
GEMINI_API_KEY=

# Free Laguna coding model via OpenRouter (explicit "use laguna" + 429 shed).
# Get one at https://openrouter.ai/settings/keys (free :free variant, no card).
# Either name works; OPENROUTER_API_KEY wins if both are set.
OPENROUTER_API_KEY=

# Default location for weather ("what's the weather" with no city).
# Examples: Chicago | New Haven, CT | London
JARVIS_LOCATION=

# Trigger key: printscreen (swallowed system-wide) or f9.
JARVIS_HOTKEY=printscreen

# Default mic — index ("1") or full device name. Find yours with:
# python push_to_talk.py --list-mics
# (Full names beat indices: BT indices shift when devices reconnect.)
JARVIS_MIC=
